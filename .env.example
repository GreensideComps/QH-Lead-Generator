# Groundline — environment variables
# Copy to .env and fill in. Never commit .env (already git-ignored).
# See docs/architecture/00-groundline-architecture.md for the full account/setup plan.

# ── Needed to build the Discover MVP (docs/product/00-product-scope.md stage 2) ──

# Supabase project — create at supabase.com. Use the anon key client-side only;
# the service-role key is for ingestion workers / product-embedded agents ONLY,
# never shipped to the browser. See docs/security/00-security-architecture.md.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key — production usage for the Extraction/Verification agents.
# Interactive Claude Code usage (this session) does not need this.
ANTHROPIC_API_KEY=

# Find a Tender Service — no key required for the public OCDS API today
# (confirmed in docs/research/02-data-sources.md); left here as a placeholder
# in case that changes or a higher-rate-limit tier is introduced.
FTS_API_BASE_URL=https://www.find-tender.service.gov.uk

# Companies House API key — free, register at developer.company-information.service.gov.uk
COMPANIES_HOUSE_API_KEY=

# ── Optional now, zero/low cost, no account required for basic use ──

# Context7 MCP (already configured keyless in .mcp.json) — only needed if you
# want the higher rate limit; get a free key at context7.com/dashboard
CONTEXT7_API_KEY=

# ── Deferred — do not provision until the documented trigger is met ──
# See docs/architecture/01-tool-and-mcp-audit.md for each trigger.

# Stripe (defer until billing is actually being built). Use a RESTRICTED key
# scoped to only what's needed, never a full secret key, if/when an agent
# touches this — docs/security/00-security-architecture.md.
# STRIPE_RESTRICTED_KEY=

# Sentry (adopt with the first real backend deployment)
# SENTRY_DSN=

# PostHog (defer until there are real users)
# POSTHOG_API_KEY=
# POSTHOG_HOST=

# Firecrawl (defer until a data source with no clean API is added)
# FIRECRAWL_API_KEY=
