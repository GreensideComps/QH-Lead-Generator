{
  "name": "groundline-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "migrate": "node --loader ts-node/esm src/db/migrate.ts",
    "ingest:fts": "node --loader ts-node/esm src/ingestion/run-fts.ts",
    "ingest:planning": "node --loader ts-node/esm src/ingestion/run-planning.ts",
    "seed:extraction": "node --loader ts-node/esm src/extraction/seed-manual-extraction.ts",
    "seed:profile": "node --loader ts-node/esm src/db/seed-business-profile.ts",
    "extract:run": "node --loader ts-node/esm src/extraction/run-extraction.ts",
    "verify:evidence": "node --loader ts-node/esm src/extraction/verifySourceSpans.ts",
    "match:run": "node --loader ts-node/esm src/matching/run-matching.ts",
    "dev": "node --loader ts-node/esm src/web/server.ts",
    "test": "node --loader ts-node/esm --test test/*.test.ts"
  },
  "dependencies": {
    "express": "^4.19.2",
    "pg": "^8.13.1",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8",
    "bcryptjs": "^2.4.3",
    "cookie-session": "^2.1.0",
    "@anthropic-ai/sdk": "^0.32.1",
    "stripe": "^17.4.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "ts-node": "^10.9.2",
    "@types/express": "^4.17.21",
    "@types/pg": "^8.11.10",
    "@types/node": "^22.9.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-session": "^2.0.49"
  }
}
