{
  "name": "groundline-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "migrate": "node --loader ts-node/esm src/db/migrate.ts",
    "ingest:fts": "node --loader ts-node/esm src/ingestion/run-fts.ts",
    "ingest:planning": "node --loader ts-node/esm src/ingestion/run-planning.ts",
    "seed:extraction": "node --loader ts-node/esm src/extraction/seed-manual-extraction.ts",
    "seed:profile": "node --loader ts-node/esm src/db/seed-business-profile.ts",
    "extract:run": "node --loader ts-node/esm src/extraction/run-extraction.ts",
    "verify:evidence": "node --loader ts-node/esm src/extraction/verifySourceSpans.ts",
    "match:run": "node --loader ts-node/esm src/matching/run-matching.ts",
    "dev": "node --loader ts-node/esm src/web/server.ts",
    "test": "node --loader ts-node/esm --test test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "bcryptjs": "^2.4.3",
    "cookie-session": "^2.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pg": "^8.13.1",
    "stripe": "^17.4.0",
    "zod": "^3.23.8"
  },
  "comment_overrides": "qs <=6.15.3 carries two moderate advisories (array-limit bypass, DoS via attacker-controlled isBuffer). express and stripe both still pin 6.15.3 transitively; 6.16.0 is the patched release and is a minor bump within the same major, so pinning it here fixes both without an express 5 upgrade.",
  "overrides": {
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
